{
  "name": "repo-rag-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server exposing GitHub repo status and semantic search over project docs.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "reindex": "tsx src/scripts/reindex.ts",
    "typecheck": "tsc --noEmit",
    "inspect": "pnpm dlx @modelcontextprotocol/inspector node dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit"
  },
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.11.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@octokit/rest": "^21.1.1",
    "better-sqlite3": "^11.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "type": "module",
  "bin": {
    "repo-rag-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ]
}
