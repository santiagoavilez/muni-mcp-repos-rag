# Copy to .env and fill in. NEVER commit .env.

# GitHub fine-grained Personal Access Token, READ-ONLY, scoped to the repos.
# Required permissions: Contents (read), Metadata (read), Pull requests (read), Issues (read).
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# Where the vector index lives. Relative paths resolve against the project root.
# Default: data/index.db
REPO_RAG_DB_PATH=data/index.db

# Ollama endpoint used for local embeddings.
REPO_RAG_OLLAMA_URL=http://localhost:11434
REPO_RAG_EMBED_MODEL=bge-m3

# github (real API) | mock (in-memory fixtures, no network, no token needed)
REPO_RAG_MODE=github

# Reindex on startup any repo whose index is older than this many hours.
# Runs in the background and never blocks the MCP handshake. 0 disables it.
REPO_RAG_AUTO_INDEX_HOURS=12
